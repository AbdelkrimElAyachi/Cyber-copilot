# Wazuh Indexer (OpenSearch) connection settings
WAZUH_INDEXER_HOST=localhost
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=changeme

# Set to "true" to verify TLS certificates (recommended in production)
WAZUH_INDEXER_VERIFY_SSL=false

# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=cyber_copilot

# AI Investigator — LLM provider settings
# LLM_PROVIDER: "local" (Ollama, no key needed) or "api" (any OpenAI-compatible API)
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# Optional: "low"/"medium"/"high" — only supported by some models (e.g.
# Groq's openai/gpt-oss-* family, OpenAI's o-series). Lowers hidden
# chain-of-thought token usage per call. Leave unset if your model doesn't
# support it.
LLM_REASONING_EFFORT=

# IP reputation lookups (check_ip_reputation tool) via AbuseIPDB's free tier
# (1000 checks/day, one request per IP). Get a key at abuseipdb.com/account/api.
# Leave blank to disable the tool entirely (it won't be offered to the AI).
ABUSEIPDB_API_KEY=

# Auth — logins are verified against the Wazuh Indexer's own users (same
# credentials as the Wazuh Dashboard); this secret only signs this app's
# own session tokens afterward. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=
# How long a login stays valid, in minutes (720 = 12h).
AUTH_TOKEN_TTL_MINUTES=720
